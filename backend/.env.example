PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/banking_app
JWT_SECRET=change_this_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=1h
CORS_ORIGIN=http://localhost:5173

# Kafka
KAFKA_BROKERS=localhost:19092

# Shared secret with workers (notifier, scheduler). Any long random string.
INTERNAL_TOKEN=change_this_to_a_long_random_internal_token

# Directory the statement worker writes PDFs to. Must match STATEMENT_DIR
# in workers/statement-worker/.env
STATEMENT_DIR=/tmp/banking-statements
